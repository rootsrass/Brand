# NVIDIA_NIM_API_KEY: Required for NVIDIA NIM API calls.
# You can get this key from build.nvidia.com
# Users configure this via the Settings menu (gear icon) in the AI Studio UI at the top right.
NVIDIA_NIM_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GITHUB_PAT: Personal Access Token from GitHub. 
# 1. Go to github.com -> Settings -> Developer Settings -> Personal Access Tokens -> Tokens (classic)
# 2. Generate new token with at least 'repo' scope.
GITHUB_PAT=

# GITHUB_REPO_OWNER: Your GitHub username (or organization name).
GITHUB_REPO_OWNER=

# GITHUB_REPO_NAME: The exact name of your GitHub repository.
# You MUST create an empty repository on GitHub first before clicking 'Auto-Initialize'.
GITHUB_REPO_NAME=